# Server file: /opt/seodaily/.env  (chmod 600). Never commit it.
POSTGRES_DB=seodaily
POSTGRES_USER=seodaily
# Letters and digits only (it is embedded in the database URL).
POSTGRES_PASSWORD=

# openssl rand -base64 48
SESSION_SECRET=

# First admin; created only while no admin exists. Change the password in the panel afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

SITE_URL=https://seodaily.ir
COOKIE_SECURE=true

# Local port the reverse proxy forwards to (must be free on the server).
APP_PORT=3000

# Optional: where ops/backup.sh keeps dumps (default ~/seodaily-backups of the
# deploy user). Keep it outside /opt/seodaily; copy it off the server regularly.
# BACKUP_DIR=/var/backups/seodaily

# ---- Plugin library (docs/plugins/OPERATIONS-RUNBOOK.md) ----
# OTP_HMAC_SECRET and INTERNAL_API_SECRET are generated by ops/deploy.sh when missing.
# SMS for download codes (Melipayamak shared service line + approved pattern).
# While these are empty, downloads stay closed (fail closed); pages still work.
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
# Numeric pattern id (bodyId) whose single variable is the code.
MELIPAYAMAK_OTP_BODY_ID=
# Numbers used for testing (comma-separated, +989…): downloads not counted publicly.
# DOWNLOAD_TEST_PHONES=
# Feature switches.
# PLUGINS_DOWNLOADS_ENABLED=true
# PLUGINS_AUTO_UPDATE_ENABLED=true
# ClamAV daemon (clamd) for package scans; without it scans are UNAVAILABLE
# and every new version waits for manual review.
# CLAMD_HOST=
# CLAMD_PORT=3310
