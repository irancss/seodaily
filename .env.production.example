# Server file: /opt/seodaily/.env  (chmod 600). Never commit it.
POSTGRES_DB=seodaily
POSTGRES_USER=seodaily
# Letters and digits only (it is embedded in the database URL).
POSTGRES_PASSWORD=

# openssl rand -base64 48
SESSION_SECRET=

# First admin; created only while no admin exists. Change the password in the panel afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

SITE_URL=https://seodaily.ir
COOKIE_SECURE=true

# Local port the reverse proxy forwards to (must be free on the server).
APP_PORT=3000
