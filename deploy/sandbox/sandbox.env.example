# Separate VM only. Generate with: openssl rand -hex 32
SANDBOX_TOKEN=
# Resolve and pin official wordpress:cli-php8.3 and mariadb:11.4 image digests.
SANDBOX_CLI_IMAGE=
SANDBOX_DB_IMAGE=
# Must describe the actual prepared core, PHP and MariaDB versions.
SANDBOX_PROFILE=
SANDBOX_TEMPLATE=/opt/seodaily-sandbox/template
