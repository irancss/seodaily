# Copy to .env and fill in. Never commit .env.

# Database (used by docker-compose for both containers)
POSTGRES_DB=seodaily
POSTGRES_USER=seodaily
POSTGRES_PASSWORD=change-me-strong-password

# Signs the admin login cookie. At least 32 random characters, e.g.:
#   openssl rand -base64 48
SESSION_SECRET=

# First admin account — created only when no admin exists yet.
# Change the password from the panel (حساب کاربری) after the first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Public address of the site (canonical URLs, sitemap, Open Graph).
# Can also be set later from the admin panel (تنظیمات سایت).
SITE_URL=http://localhost:3000

# Set to true once the site is served over HTTPS.
COOKIE_SECURE=false

# Host port the app is published on.
APP_PORT=3000

# Local development without Docker:
# DATABASE_URL=postgres://seodaily:change-me-strong-password@localhost:5432/seodaily

# Where Docker Hub is blocked (e.g. from Iran), pull the base images from a mirror:
# NODE_IMAGE=docker.arvancloud.ir/node:22-alpine
# POSTGRES_IMAGE=docker.arvancloud.ir/postgres:16-alpine

# Address range of the project's Docker network (change only if it clashes with your LAN/VPN).
# DOCKER_SUBNET=10.203.77.0/24

# Plugin library (see docs/plugins/OPERATIONS-RUNBOOK.md). Downloads stay closed
# until both the OTP secret and the SMS settings exist.
# OTP_HMAC_SECRET=          (openssl rand -base64 48)
# INTERNAL_API_SECRET=      (openssl rand -base64 48)
# MELIPAYAMAK_USERNAME=
# MELIPAYAMAK_PASSWORD=
# MELIPAYAMAK_OTP_BODY_ID=
# PLUGIN_FILES_DIR=./plugin-files   (local runs without Docker)
# Compose includes ClamAV without exposing its port to the host.
CLAMD_HOST=clamav
CLAMD_PORT=3310
# Separate VM runner; see deploy/sandbox/README.md. Empty keeps auto-publish closed.
PLUGIN_SANDBOX_URL=
PLUGIN_SANDBOX_TOKEN=
PLUGIN_SANDBOX_TIMEOUT_S=240
PLUGIN_REVIEW_TTL_D=30
