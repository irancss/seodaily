# Copy to .env and fill in. Never commit .env.

# Database (used by docker-compose for both containers)
POSTGRES_DB=seodaily
POSTGRES_USER=seodaily
POSTGRES_PASSWORD=change-me-strong-password

# Signs the admin login cookie. At least 32 random characters, e.g.:
#   openssl rand -base64 48
SESSION_SECRET=

# First admin account — created only when no admin exists yet.
# Change the password from the panel (حساب کاربری) after the first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Public address of the site (canonical URLs, sitemap, Open Graph).
# Can also be set later from the admin panel (تنظیمات سایت).
SITE_URL=http://localhost:3000

# Set to true once the site is served over HTTPS.
COOKIE_SECURE=false

# Host port the app is published on.
APP_PORT=3000

# Local development without Docker:
# DATABASE_URL=postgres://seodaily:change-me-strong-password@localhost:5432/seodaily

# Where Docker Hub is blocked (e.g. from Iran), pull the base images from a mirror:
# NODE_IMAGE=docker.arvancloud.ir/node:22-alpine
# POSTGRES_IMAGE=docker.arvancloud.ir/postgres:16-alpine
